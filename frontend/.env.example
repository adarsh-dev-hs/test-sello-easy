# Frontend build-time settings (Vite). On Vercel, set these under Project → Settings → Environment Variables.

# true  = frontend-only demo: in-browser mock API with sample data, simulated pipelines, no backend needed
# false = talk to a real SelloQ backend at VITE_API_BASE
VITE_DEMO_MODE=false

# Backend API base URL (used when VITE_DEMO_MODE=false). Same-origin default works behind the nginx proxy.
# For Vercel + a hosted backend: https://api.your-domain.com/api/v1  (add the Vercel URL to CORS_ORIGINS on the backend)
VITE_API_BASE=/api/v1
