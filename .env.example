# ============================================================
# SelloEasy — copy to .env and fill in OPENAI_API_KEY
#   cp .env.example .env
# ============================================================

# ---------- App ----------
APP_ENV=local
APP_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
FILE_URL_SIGNING_KEY=change-me-too
# URL the MCP servers use to download uploaded files (signed, short-lived links)
PUBLIC_BACKEND_URL=http://backend:8000
CORS_ORIGINS=http://localhost:5173
SEED_DEMO=true
DEMO_USER_EMAIL=demo@selloeasy.local
DEMO_USER_PASSWORD=demo1234
DEMO_SITES_BASE_URL=http://demo-sites

# ---------- Postgres ----------
POSTGRES_USER=selloeasy
POSTGRES_PASSWORD=selloeasy
POSTGRES_DB=selloeasy
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://selloeasy:selloeasy@postgres:5432/selloeasy

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- LLM (OpenAI) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_CHEAP=gpt-5-nano
# lead qualification needs careful reasoning; empty = use OPENAI_MODEL
OPENAI_MODEL_QUALIFY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
LLM_MAX_CONCURRENCY=4

# ---------- MCP ----------
MCP_SHARED_TOKEN=local-dev-mcp-token
MCP_WEBSCRAPER_URL=http://mcp-webscraper:9001/mcp
MCP_DOCPARSER_URL=http://mcp-docparser:9002/mcp
MCP_SIGNALS_URL=http://mcp-signals:9003/mcp
MCP_CALL_TIMEOUT_SECONDS=90
# fixture = deterministic demo data (no keys needed) | live = Tavily/Exa/X/Reddit/Hunter
PROVIDER_MODE=fixture
MAX_MCP_CALLS_PER_RUN=150
MAX_LLM_CALLS_PER_RUN=80
# Re-run signals for all ready companies every N hours (0 = manual only)
SIGNAL_RUN_INTERVAL_HOURS=0

# ---------- Optional live providers (PROVIDER_MODE=live) ----------
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
HUNTER_API_KEY=
APOLLO_API_KEY=

# ---------- Email (Mailpit captures everything locally: http://localhost:8025) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SelloEasy Demo <demo@selloeasy.local>"
